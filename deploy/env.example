# ==========================================
# Cấu hình Docker Registry (Harbor)
# ==========================================
# Domain Harbor registry, dùng để pull image backend/frontend
HARBOR_REGISTRY=registry.domain.vn
# Tag image sẽ deploy. CD pipeline có thể ghi đè giá trị này (mặc định: latest)
IMAGE_TAG=latest

# ==========================================
# Cấu hình Database MySQL
# ==========================================
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=keyboardstore
DB_USER=keyboard_user
DB_PASSWORD=keyboard_password

# ==========================================
# Cấu hình Authentication (JWT)
# ==========================================
# Thay thế chuỗi này bằng một khóa bảo mật ngẫu nhiên (tối thiểu 32 ký tự)
JWT_SECRET_KEY=ThayTheBangKhoaBaoMatCuaBanItNhat32KyTu!

# ==========================================
# Cấu hình Dịch vụ Gửi Email (SMTP)
# ==========================================
EMAIL_SENDER_EMAIL=your_email@gmail.com
EMAIL_USERNAME=your_email@gmail.com
# Mật khẩu ứng dụng Gmail (App Password), không phải mật khẩu tài khoản chính
EMAIL_PASSWORD=your_app_password

# ==========================================
# Cấu hình VNPay Sandbox Payment
# ==========================================
VNPAY_TMN_CODE=your_tmn_code_here
VNPAY_HASH_SECRET=your_hash_secret_here

# ==========================================
# Cấu hình Tên miền / URL bên ngoài
# ==========================================
# API_BASE_URL: URL để client từ ngoài gọi API (thông qua cổng Nginx 80)
API_BASE_URL=http://localhost
# FRONTEND_BASE_URL: Trang chủ của Frontend
FRONTEND_BASE_URL=http://localhost

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5143

ConnectionStrings__DefaultConnection=server=127.0.0.1;port=3306;database=KeyboardStoreDB;user=keyboardstore;password=CHANGE_ME;SslMode=Preferred
ConnectionStrings__Redis=127.0.0.1:6379

EmailSettings__SenderEmail=no-reply@example.com
EmailSettings__Username=no-reply@example.com
EmailSettings__Password=CHANGE_ME

JwtSettings__SecretKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

VNPaySettings__TmnCode=CHANGE_ME
VNPaySettings__HashSecret=CHANGE_ME
VNPaySettings__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPaySettings__ReturnUrl=https://api.example.com/api/Payment/vnpay-return

AppSettings__ApiBaseUrl=https://api.example.com
AppSettings__FrontendBaseUrl=https://example.com

Cors__AllowedOrigins__0=https://example.com

UploadSettings__RootPath=/var/lib/keyboardstore/uploads
UploadSettings__RequestPath=/uploads
UploadSettings__ProductFolder=products
